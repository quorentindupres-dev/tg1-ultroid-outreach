# TG1 (Ultroid) - Multi-Account Telegram Userbot
# Copy to .env and fill in your values

# === REQUIRED: Telegram API credentials ===
# Get these from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# === REQUIRED: Session string ===
# Generate by running: docker compose run --rm ultroid python3 sessiongen
SESSION=

# === REDIS (keep defaults for Docker) ===
REDIS_URI=redis://redis:6379
REDIS_PASSWORD=

# === OPTIONAL: Multi-account (up to 5 total) ===
# Generate separate sessions for each account
# SESSION2=
# SESSION3=
# SESSION4=
# SESSION5=

# === OPTIONAL: Assistant bot ===
# Get token from @BotFather on Telegram
# BOT_TOKEN=123456:ABC-DEF1234ghikl

# === OPTIONAL: Log channel ===
# Channel ID where logs are sent
# LOG_CHANNEL=-1001234567890
